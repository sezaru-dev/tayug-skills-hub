// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  image     String?
  password  String  
  role      Role     @default(PROVIDER)
  createdAt DateTime @default(now())

  profile   Profile?
  providerSkills ProviderSkills[]
  projects  Project[]

  savedProviders SavedProvider[] @relation("SavedByUser")
  savedBy SavedProvider[] @relation("SavedProvider")
}

model SkillCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  skills    Skill[]
}

model Skill {
  id          String   @id @default(cuid())
  name        String  
  slug        String   
  isActive    Boolean  @default(true)

  categoryId  String
  category    SkillCategory @relation(fields: [categoryId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  providerSkills ProviderSkills[]
  projectSkills  ProjectSkill[]

  @@unique([name, categoryId])
  @@unique([slug, categoryId])

  // Indexes
  @@index([slug])
  @@index([categoryId])
}

model Profile {
  id          String   @id
  user        User     @relation(fields: [id], references: [id], onDelete: Cascade)

  fullname    String
  headline    String
  barangay    String
  about       String

  phoneNumber String
  telNumber   String?

  isPublished Boolean  @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([fullname])
}

model ProviderSkills {
  id      String @id @default(cuid())

  userId  String
  skillId String

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])

  @@index([userId])
  @@index([skillId, userId])
}

model Project {
  id          String   @id @default(cuid())

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  imageUrl    String?
  imagePublicId  String?
  
  title       String
  description String?
  liveUrl     String?

  skills      ProjectSkill[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model ProjectSkill {
  projectId String
  skillId   String

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  skill     Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([projectId, skillId]) // composite primary key
  @@index([skillId])
}

model SavedProvider {
  id          String @id @default(cuid())

  userId      String
  providerId  String

  user        User @relation("SavedByUser", fields: [userId], references: [id], onDelete: Cascade)
  provider    User @relation("SavedProvider", fields: [providerId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())

  @@unique([userId, providerId])
  @@index([userId])
  @@index([providerId])
}

enum Role {
  PROVIDER
  ADMIN
}